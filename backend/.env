# Konfigurasi Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Kunci Rahasia JWT
JWT_SECRET=spotify_lite_super_secret_jwt_key_2026_production_anti_lag
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=spotify_lite_refresh_key_ultra_secure_2026
JWT_REFRESH_EXPIRES_IN=7d

# Konfigurasi Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spotify_lite

# Konfigurasi Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Konfigurasi Penyimpanan Berkas
STORAGE_PATH=./storage
MAX_AUDIO_SIZE_MB=30
MAX_IMAGE_SIZE_MB=5
